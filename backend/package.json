{
  "name": "ine-price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend for INE Product Price Tracker",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "scrape:all": "node -r dotenv/config -e \"require('./src/scraper/scheduler').scrapeAll()\"",
